FLASK_ENV=development
# REQUIRED in production. Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in production the app refuses to start; in development a random
# per-process value is generated automatically.
SECRET_KEY=change-this-in-production-min-32-chars
JWT_SECRET_KEY=change-this-jwt-key-in-production-min-32-chars
DATABASE_URL=sqlite:///warehouse.db
# Comma-separated CORS allowlist (e.g. https://app.example.com,https://admin.example.com).
# Defaults to "*" (no credentials). Set an explicit allowlist in production.
CORS_ORIGINS=*
PORT=5000
HOST=0.0.0.0
